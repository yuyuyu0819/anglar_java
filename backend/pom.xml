<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    官公庁案件で典型的な Maven の親POM指定方式。
    spring-boot-starter-parent を親にすると、主要ライブラリのバージョンが
    「依存関係管理(dependencyManagement)」でまとめて固定されるため、
    個々の <dependency> に <version> を書かなくて済む。
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>jp.go.sample</groupId>
  <artifactId>backend</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>backend</name>
  <description>申請管理システム サンプル（キャッチアップ用）</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <mybatis-spring-boot.version>3.0.5</mybatis-spring-boot.version>
  </properties>

  <dependencies>
    <!-- REST API（Spring MVC + 組込みTomcat） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Bean Validation（@NotBlank / @Size などの入力チェック） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ヘルスチェック等の運用エンドポイント。官公庁案件では監視要件でよく入る -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- MyBatis：SQLを自分で書くタイプのO/Rマッパー。日本のSI/官公庁案件で主流 -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>${mybatis-spring-boot.version}</version>
    </dependency>

    <!--
      PostgreSQL の JDBC ドライバ（既定で使用するDB）。
      scope=runtime … コンパイル時には不要で、実行時にのみ必要なため。
      ドライバのクラスをソースから直接参照することは無いので compile スコープにしない。
      バージョンは spring-boot-starter-parent が管理している。
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      H2 インメモリDB。
      以下の2つの用途で使うため、test ではなく runtime スコープにしている。
        1. 自動テスト（@ActiveProfiles("h2")）
        2. PostgreSQL を起動せずにアプリを動かしたいとき
           （.\start-backend.ps1 -H2）
    -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- getter/setter/コンストラクタの自動生成。日本のJava案件では採用率が非常に高い -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- テスト -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <!-- Lombok はコンパイル時のみ必要なので実行可能JARには含めない -->
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- MyBatis のメソッド引数名を保持するため（@Param 省略時に効く） -->
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
